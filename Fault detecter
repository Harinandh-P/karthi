
#include <DHT.h>
#include <math.h>

// ==================================================
//                PIN CONFIGURATION
// ==================================================

#define DHT_PIN       3
#define DHT_TYPE      DHT22

#define VIBRATION_PIN 2
#define ACS_PIN       A0

#define GREEN_LED     8
#define ORANGE_LED    9
#define RED_LED       10

#define BUZZER_PIN    11

// ==================================================
//                 SENSOR SETTINGS
// ==================================================

DHT dht(DHT_PIN, DHT_TYPE);

// ACS712 5A sensor sensitivity
const float ACS_SENSITIVITY = 0.185;

// Current thresholds
const float WARNING_CURRENT = 3.0;
const float DANGER_CURRENT  = 4.0;

// Display change limits
const float CURRENT_CHANGE_LIMIT = 0.05;
const float TEMP_CHANGE_LIMIT = 0.2;

// Vibration detection hold time
const unsigned long VIBRATION_HOLD_TIME = 1500;

// ==================================================
//                    VARIABLES
// ==================================================

float zeroVoltage = 2.5;

float currentValue = 0.0;
float filteredCurrent = 0.0;

float lastPrintedCurrent = -100.0;
float lastPrintedTemp = -100.0;

bool firstCurrentReading = true;
bool firstTempReading = true;

int currentStatus = -1;

unsigned long lastCurrentRead = 0;
unsigned long lastDHTRead = 0;

unsigned long lastBeepTime = 0;
unsigned long beepStartTime = 0;

unsigned long lastVibrationTime = 0;

bool vibrationSeen = false;
bool vibrationActive = false;

bool buzzerOn = false;

// Interrupt flag
volatile bool vibrationEvent = false;

// ==================================================
//             VIBRATION INTERRUPT
// ==================================================

void vibrationISR() {
  vibrationEvent = true;
}

// ==================================================
//              ACS712 CALIBRATION
// ==================================================

void calibrateACS712() {

  Serial.println("Calibrating ACS712...");
  Serial.println("Keep motor OFF during calibration.");

  long total = 0;

  for (int i = 0; i < 500; i++) {
    total += analogRead(ACS_PIN);
    delay(2);
  }

  float averageADC = total / 500.0;

  zeroVoltage = averageADC * (5.0 / 1023.0);

  Serial.print("ACS712 Zero Voltage: ");
  Serial.println(zeroVoltage, 3);

  Serial.println("Calibration completed.");
}

// ==================================================
//               CURRENT MEASUREMENT
// ==================================================

float readCurrent() {

  long total = 0;

  for (int i = 0; i < 40; i++) {
    total += analogRead(ACS_PIN);
    delay(2);
  }

  float averageADC = total / 40.0;

  float voltage = averageADC * (5.0 / 1023.0);

  float current = fabs(voltage - zeroVoltage)
                  / ACS_SENSITIVITY;

  return current;
}

// ==================================================
//                CURRENT STATUS
// ==================================================

void checkCurrentStatus() {

  int newStatus;

  if (filteredCurrent < WARNING_CURRENT) {
    newStatus = 0;
  }

  else if (filteredCurrent < DANGER_CURRENT) {
    newStatus = 1;
  }

  else {
    newStatus = 2;
  }

  if (newStatus != currentStatus) {

    currentStatus = newStatus;

    if (currentStatus == 0) {
      Serial.println("STATUS: SAFE");
    }

    else if (currentStatus == 1) {
      Serial.println("WARNING: HIGH CURRENT!");
    }

    else {
      Serial.println("DANGER: CRITICAL CURRENT!");
    }
  }
}

// ==================================================
//                   LED CONTROL
// ==================================================

void updateLEDs() {

  digitalWrite(GREEN_LED, LOW);
  digitalWrite(ORANGE_LED, LOW);
  digitalWrite(RED_LED, LOW);

  // Danger current OR vibration
  if (currentStatus == 2 || vibrationActive) {

    digitalWrite(RED_LED, HIGH);
  }

  // Warning current
  else if (currentStatus == 1) {

    digitalWrite(ORANGE_LED, HIGH);
  }

  // Normal condition
  else {

    digitalWrite(GREEN_LED, HIGH);
  }
}

// ==================================================
//              VIBRATION MONITORING
// ==================================================

void checkVibration() {

  bool eventDetected = false;

  noInterrupts();

  if (vibrationEvent) {
    vibrationEvent = false;
    eventDetected = true;
  }

  interrupts();

  if (eventDetected) {

    unsigned long now = millis();

    // Debounce repeated signals
    if (!vibrationSeen ||
        now - lastVibrationTime > 100) {

      lastVibrationTime = now;
      vibrationSeen = true;

      Serial.println("DANGER: VIBRATION DETECTED!");
    }
  }

  // Keep vibration alert active temporarily
  if (vibrationSeen &&
      millis() - lastVibrationTime >= VIBRATION_HOLD_TIME) {

    vibrationSeen = false;

    Serial.println("Vibration returned to normal.");
  }

  vibrationActive = vibrationSeen;
}

// ==================================================
//                  BUZZER CONTROL
// ==================================================

void updateBuzzer() {

  unsigned long now = millis();

  unsigned long interval;
  unsigned long beepDuration;

  // Danger current or vibration
  if (currentStatus == 2 || vibrationActive) {

    interval = 300;
    beepDuration = 200;
  }

  // Warning current
  else if (currentStatus == 1) {

    interval = 1000;
    beepDuration = 150;
  }

  // Safe condition
  else {

    noTone(BUZZER_PIN);
    buzzerOn = false;

    return;
  }

  // Start buzzer
  if (!buzzerOn &&
      now - lastBeepTime >= interval) {

    tone(BUZZER_PIN, 2000);

    buzzerOn = true;

    beepStartTime = now;
    lastBeepTime = now;
  }

  // Stop buzzer after beep duration
  if (buzzerOn &&
      now - beepStartTime >= beepDuration) {

    noTone(BUZZER_PIN);

    buzzerOn = false;
  }
}

// ==================================================
//                      SETUP
// ==================================================

void setup() {

  Serial.begin(9600);

  pinMode(VIBRATION_PIN, INPUT);

  pinMode(GREEN_LED, OUTPUT);
  pinMode(ORANGE_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);

  pinMode(BUZZER_PIN, OUTPUT);

  dht.begin();

  Serial.println();
  Serial.println("================================");
  Serial.println(" INDUSTRIAL FAULT MONITORING");
  Serial.println("================================");

  // Calibrate current sensor
  calibrateACS712();

  // SW-420: detect HIGH-to-LOW transition
  attachInterrupt(
    digitalPinToInterrupt(VIBRATION_PIN),
    vibrationISR,
    FALLING
  );

  currentStatus = 0;
  vibrationActive = false;

  updateLEDs();

  Serial.println("System monitoring started.");
  Serial.println("--------------------------------");
}

// ==================================================
//                    MAIN LOOP
// ==================================================

void loop() {

  unsigned long now = millis();

  // ----------------------------------------------
  //             CURRENT MONITORING
  // ----------------------------------------------

  if (now - lastCurrentRead >= 250) {

    lastCurrentRead = now;

    currentValue = readCurrent();

    if (firstCurrentReading) {

      filteredCurrent = currentValue;
      firstCurrentReading = false;
    }

    else {

      filteredCurrent =
        (0.7 * filteredCurrent) +
        (0.3 * currentValue);
    }

    // Print only when current changes
    if (fabs(filteredCurrent - lastPrintedCurrent)
        >= CURRENT_CHANGE_LIMIT) {

      Serial.print("Current: ");
      Serial.print(filteredCurrent, 2);
      Serial.println(" A");

      lastPrintedCurrent = filteredCurrent;
    }

    checkCurrentStatus();
  }

  // ----------------------------------------------
  //            TEMPERATURE MONITORING
  // ----------------------------------------------

  if (now - lastDHTRead >= 2000) {

    lastDHTRead = now;

    float temperature = dht.readTemperature();

    if (!isnan(temperature)) {

      // Print only when temperature changes
      if (firstTempReading ||
          fabs(temperature - lastPrintedTemp)
          >= TEMP_CHANGE_LIMIT) {

        Serial.print("Temperature: ");
        Serial.print(temperature, 1);
        Serial.println(" C");

        lastPrintedTemp = temperature;
        firstTempReading = false;
      }
    }

    else {

      Serial.println("DHT22 sensor reading error.");
    }
  }

  // ----------------------------------------------
  //             VIBRATION MONITORING
  // ----------------------------------------------

  checkVibration();

  // ----------------------------------------------
  //                OUTPUT CONTROL
  // ----------------------------------------------

  updateLEDs();

  updateBuzzer();
}
