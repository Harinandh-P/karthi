
#include <DHT.h>
#include <math.h>

// ==================================================
// PIN CONFIGURATION
// ==================================================

#define DHT_PIN       3
#define DHT_TYPE      DHT22

#define VIBRATION_PIN 2
#define ACS_PIN       A0

#define GREEN_LED     8
#define ORANGE_LED    9
#define RED_LED       10
#define BUZZER_PIN    11

// ==================================================
// SENSOR CONFIGURATION
// ==================================================

DHT dht(DHT_PIN, DHT_TYPE);

// ACS712 5A sensitivity
const float ACS_SENSITIVITY = 0.185;

// Current thresholds (relative to initial current)
const float CURRENT_WARNING_RISE = 1.0;
const float CURRENT_ALERT_RISE   = 2.0;

// Temperature thresholds (relative to initial temperature)
const float TEMP_WARNING_RISE = 4.0;
const float TEMP_ALERT_RISE   = 6.0;

// Display change limits
const float CURRENT_CHANGE_LIMIT = 0.05;
const float TEMP_CHANGE_LIMIT = 0.2;

// Vibration alert duration
const unsigned long VIBRATION_HOLD_TIME = 1500;

// ==================================================
// VARIABLES
// ==================================================

float zeroVoltage = 2.5;

float currentValue = 0.0;
float temperature = 0.0;

float currentBaseline = 0.0;
float temperatureBaseline = 0.0;

float lastPrintedCurrent = -100.0;
float lastPrintedTemp = -100.0;

bool currentBaselineSet = false;
bool temperatureBaselineSet = false;

bool firstCurrentPrint = true;
bool firstTempPrint = true;

int systemStatus = 0;

unsigned long lastCurrentRead = 0;
unsigned long lastDHTRead = 0;

unsigned long lastBeepTime = 0;
unsigned long beepStartTime = 0;
unsigned long lastVibrationTime = 0;

bool buzzerOn = false;
bool vibrationActive = false;

volatile bool vibrationEvent = false;

// ==================================================
// VIBRATION INTERRUPT
// ==================================================

void vibrationISR() {
  vibrationEvent = true;
}

// ==================================================
// ACS712 CALIBRATION
// ==================================================

void calibrateACS712() {

  Serial.println("Calibrating ACS712...");
  Serial.println("Keep motor OFF.");

  long total = 0;

  for (int i = 0; i < 500; i++) {
    total += analogRead(ACS_PIN);
    delay(2);
  }

  float averageADC = total / 500.0;

  zeroVoltage = averageADC * (5.0 / 1023.0);

  Serial.print("ACS712 zero voltage: ");
  Serial.println(zeroVoltage, 3);

  Serial.println("Calibration complete.");
}

// ==================================================
// CURRENT MEASUREMENT
// ==================================================

float readCurrent() {

  long total = 0;

  for (int i = 0; i < 40; i++) {
    total += analogRead(ACS_PIN);
    delay(2);
  }

  float averageADC = total / 40.0;

  float voltage = averageADC * (5.0 / 1023.0);

  return fabs(voltage - zeroVoltage)
         / ACS_SENSITIVITY;
}

// ==================================================
// SYSTEM STATUS
// ==================================================

void checkSystemStatus() {

  int currentStatus = 0;
  int tempStatus = 0;

  // Current monitoring
  if (currentBaselineSet) {

    float currentRise = currentValue - currentBaseline;

    if (currentRise >= CURRENT_ALERT_RISE) {
      currentStatus = 2;
    }
    else if (currentRise >= CURRENT_WARNING_RISE) {
      currentStatus = 1;
    }
  }

  // Temperature monitoring
  if (temperatureBaselineSet) {

    float tempRise = temperature - temperatureBaseline;

    if (tempRise >= TEMP_ALERT_RISE) {
      tempStatus = 2;
    }
    else if (tempRise >= TEMP_WARNING_RISE) {
      tempStatus = 1;
    }
  }

  // Highest severity determines system status
  int newStatus = max(currentStatus, tempStatus);

  if (newStatus != systemStatus) {

    systemStatus = newStatus;

    if (systemStatus == 0) {
      Serial.println("STATUS: NORMAL");
    }
    else if (systemStatus == 1) {
      Serial.println("WARNING: SENSOR VALUE INCREASED!");
    }
    else {
      Serial.println("ALERT: CRITICAL SENSOR INCREASE!");
    }
  }
}

// ==================================================
// LED CONTROL
// ==================================================

void updateLEDs() {

  digitalWrite(GREEN_LED, LOW);
  digitalWrite(ORANGE_LED, LOW);
  digitalWrite(RED_LED, LOW);

  if (vibrationActive || systemStatus == 2) {

    digitalWrite(RED_LED, HIGH);
  }
  else if (systemStatus == 1) {

    digitalWrite(ORANGE_LED, HIGH);
  }
  else {

    digitalWrite(GREEN_LED, HIGH);
  }
}

// ==================================================
// VIBRATION MONITORING
// ==================================================

void checkVibration() {

  bool eventDetected = false;

  noInterrupts();

  if (vibrationEvent) {
    vibrationEvent = false;
    eventDetected = true;
  }

  interrupts();

  if (eventDetected) {

    unsigned long now = millis();

    if (!vibrationActive ||
        now - lastVibrationTime > 100) {

      lastVibrationTime = now;

      if (!vibrationActive) {
        Serial.println("ALERT: VIBRATION DETECTED!");
      }

      vibrationActive = true;
    }
  }

  if (vibrationActive &&
      millis() - lastVibrationTime >= VIBRATION_HOLD_TIME) {

    vibrationActive = false;

    Serial.println("Vibration returned to normal.");
  }
}

// ==================================================
// BUZZER CONTROL
// ==================================================

void updateBuzzer() {

  unsigned long now = millis();

  unsigned long interval;
  unsigned long beepDuration;

  // Fast beep: vibration or critical alert
  if (vibrationActive || systemStatus == 2) {

    interval = 300;
    beepDuration = 200;
  }

  // Slow beep: warning
  else if (systemStatus == 1) {

    interval = 1000;
    beepDuration = 150;
  }

  // Normal condition
  else {

    noTone(BUZZER_PIN);
    buzzerOn = false;

    return;
  }

  if (!buzzerOn &&
      now - lastBeepTime >= interval) {

    tone(BUZZER_PIN, 2000);

    buzzerOn = true;
    beepStartTime = now;
    lastBeepTime = now;
  }

  if (buzzerOn &&
      now - beepStartTime >= beepDuration) {

    noTone(BUZZER_PIN);
    buzzerOn = false;
  }
}

// ==================================================
// SETUP
// ==================================================

void setup() {

  Serial.begin(9600);

  pinMode(VIBRATION_PIN, INPUT);

  pinMode(GREEN_LED, OUTPUT);
  pinMode(ORANGE_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);

  pinMode(BUZZER_PIN, OUTPUT);

  dht.begin();

  Serial.println();
  Serial.println("==================================");
  Serial.println(" INDUSTRIAL FAULT MONITORING SYSTEM");
  Serial.println("==================================");

  // Calibrate current sensor with motor OFF
  calibrateACS712();

  // SW-420 detects HIGH-to-LOW transition
  attachInterrupt(
    digitalPinToInterrupt(VIBRATION_PIN),
    vibrationISR,
    FALLING
  );

  systemStatus = 0;

  updateLEDs();

  Serial.println("Waiting for initial sensor readings...");
}

// ==================================================
// MAIN LOOP
// ==================================================

void loop() {

  unsigned long now = millis();

  // ----------------------------------------------
  // CURRENT MONITORING
  // ----------------------------------------------

  if (now - lastCurrentRead >= 250) {

    lastCurrentRead = now;

    currentValue = readCurrent();

    // Capture first current as baseline
    if (!currentBaselineSet) {

      currentBaseline = currentValue;
      currentBaselineSet = true;

      Serial.print("Initial Current: ");
      Serial.print(currentBaseline, 2);
      Serial.println(" A");
    }

    // Print only when current changes
    if (firstCurrentPrint ||
        fabs(currentValue - lastPrintedCurrent)
        >= CURRENT_CHANGE_LIMIT) {

      Serial.print("Current: ");
      Serial.print(currentValue, 2);
      Serial.println(" A");

      lastPrintedCurrent = currentValue;
      firstCurrentPrint = false;
    }

    checkSystemStatus();
  }

  // ----------------------------------------------
  // TEMPERATURE MONITORING
  // ----------------------------------------------

  if (now - lastDHTRead >= 2000) {

    lastDHTRead = now;

    float newTemperature = dht.readTemperature();

    if (!isnan(newTemperature)) {

      temperature = newTemperature;

      // Capture first temperature as baseline
      if (!temperatureBaselineSet) {

        temperatureBaseline = temperature;
        temperatureBaselineSet = true;

        Serial.print("Initial Temperature: ");
        Serial.print(temperatureBaseline, 1);
        Serial.println(" C");
      }

      // Print only when temperature changes
      if (firstTempPrint ||
          fabs(temperature - lastPrintedTemp)
          >= TEMP_CHANGE_LIMIT) {

        Serial.print("Temperature: ");
        Serial.print(temperature, 1);
        Serial.println(" C");

        lastPrintedTemp = temperature;
        firstTempPrint = false;
      }

      checkSystemStatus();
    }
  }

  // ----------------------------------------------
  // VIBRATION MONITORING
  // ----------------------------------------------

  checkVibration();

  // ----------------------------------------------
  // OUTPUT CONTROL
  // ----------------------------------------------

  updateLEDs();
  updateBuzzer();
}

